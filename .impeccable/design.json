      "css": ".ds-filter{--sans:\"Archivo\",system-ui,sans-serif;--serif:\"Source Serif 4\",Georgia,serif;--mono:\"JetBrains Mono\",ui-monospace,monospace;display:flex;gap:8px}.ds-fbtn{min-height:44px;padding:0 16px;background:transparent;color:var(--ink,#12151b);border:1px solid var(--rule,#c4cad6);border-radius:3px;font:600 .92rem/1 var(--sans);cursor:pointer}.ds-fbtn b{font-family:var(--mono);font-weight:600;margin-left:6px}.ds-fbtn[aria-pressed=\"true\"]{background:var(--ink,#12151b);color:var(--sheet,#fff);border-color:var(--ink,#12151b)}.ds-fbtn:hover:not([aria-pressed=\"true\"]){border-color:var(--ink,#12151b)}.ds-fbtn:focus-visible{outline:2px solid var(--focus,#1b2f8f);outline-offset:3px}"
