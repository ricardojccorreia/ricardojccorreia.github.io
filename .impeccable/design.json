      "html": "<header class=\"ds-band\"><span class=\"ds-c\">(19)</span><span class=\"ds-who\">Universidade do Porto · FMUP / MEDCIDS</span><span class=\"ds-ctl\"><button type=\"button\" class=\"ds-ctl-btn\">EN</button><button type=\"button\" class=\"ds-ctl-btn\" aria-label=\"Tema escuro\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z\"/></svg></button></span></header>",
